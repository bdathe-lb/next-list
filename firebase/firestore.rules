rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function memberPath(groupId, uid) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(uid);
    }

    function isActiveMember(groupId) {
      return signedIn()
        && exists(groupPath(groupId))
        && get(groupPath(groupId)).data.status == "active"
        && exists(memberPath(groupId, request.auth.uid))
        && get(memberPath(groupId, request.auth.uid)).data.status == "active";
    }

    function isOwnMembership() {
      return signedIn()
        && resource.data.userId == request.auth.uid;
    }

    function validNickname(value) {
      return value is string && value.size() >= 2 && value.size() <= 20;
    }

    function validAvatarPath(uid, value) {
      return value == null
        || (
          value is string
          && value.matches(
            '^users/' + uid + '/avatar/[A-Za-z0-9_-]+[.]webp$'
          )
        );
    }

    function validNotificationPrefs(value) {
      return value is map
        && value.keys().hasAll([
          "groupInvite",
          "newSchedule",
          "upcomingReminder",
          "ideaComment"
        ])
        && value.keys().hasOnly([
          "groupInvite",
          "newSchedule",
          "upcomingReminder",
          "ideaComment"
        ])
        && value.groupInvite is bool
        && value.newSchedule is bool
        && value.upcomingReminder is bool
        && value.ideaComment is bool;
    }

    function tokenEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function validUserShape(uid, value) {
      return value.keys().hasAll([
          "nickname",
          "avatarPath",
          "emailVerified",
          "notificationPrefs",
          "status",
          "createdAt",
          "updatedAt",
          "schemaVersion"
        ])
        && value.keys().hasOnly([
          "nickname",
          "avatarPath",
          "emailVerified",
          "notificationPrefs",
          "status",
          "createdAt",
          "updatedAt",
          "schemaVersion"
        ])
        && validNickname(value.nickname)
        && validAvatarPath(uid, value.avatarPath)
        && value.emailVerified is bool
        && validNotificationPrefs(value.notificationPrefs)
        && value.status == "active"
        && value.createdAt is timestamp
        && value.updatedAt is timestamp
        && value.schemaVersion == 1;
    }

    function validUserCreate(uid) {
      return isOwner(uid)
        && validUserShape(uid, request.resource.data)
        && request.resource.data.emailVerified == tokenEmailVerified()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if validUserCreate(uid);
      allow update: if isOwner(uid)
        && validUserShape(uid, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "nickname",
          "avatarPath",
          "notificationPrefs",
          "emailVerified",
          "updatedAt"
        ])
        && request.resource.data.updatedAt == request.time
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(["emailVerified"])
          || request.resource.data.emailVerified == tokenEmailVerified()
        );
      allow delete: if false;

      match /devices/{deviceId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /feed/{feedId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]);
        allow create, delete: if false;
      }

      match /invitations/{invitationId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "respondedAt"
          ])
          && resource.data.status == "pending"
          && request.resource.data.status == "declined"
          && request.resource.data.respondedAt == request.time;
        allow create, delete: if false;
      }
    }

    match /groups/{groupId} {
      allow read: if isActiveMember(groupId);
      allow write: if false;

      match /members/{uid} {
        allow read: if isOwnMembership() || isActiveMember(groupId);
        allow write: if false;
      }

      match /ideas/{ideaId} {
        allow read: if isActiveMember(groupId);
        allow write: if false;

        match /{subcollection}/{documentId} {
          allow read: if isActiveMember(groupId);
          allow write: if false;
        }
      }
    }

    match /groupInvites/{inviteId} {
      allow read, write: if false;
    }

    match /functionEvents/{eventId} {
      allow read, write: if false;
    }

    match /{path=**}/members/{uid} {
      allow read: if isOwnMembership();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
