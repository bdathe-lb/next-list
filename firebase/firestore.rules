rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function memberPath(groupId, uid) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(uid);
    }

    function isActiveMember(groupId) {
      return signedIn()
        && exists(groupPath(groupId))
        && get(groupPath(groupId)).data.status == "active"
        && exists(memberPath(groupId, request.auth.uid))
        && get(memberPath(groupId, request.auth.uid)).data.status == "active";
    }

    function isOwnMembership() {
      return signedIn()
        && resource.data.userId == request.auth.uid;
    }

    function isAdmin(groupId) {
      return isActiveMember(groupId)
        && get(memberPath(groupId, request.auth.uid)).data.role == "admin";
    }

    function currentProfileSnapshot(groupId) {
      return get(memberPath(groupId, request.auth.uid)).data.profileSnapshot;
    }

    function validSnapshot(value) {
      return value is map
        && value.keys().hasAll(["nickname", "avatarPath"])
        && value.keys().hasOnly(["nickname", "avatarPath"])
        && value.nickname is string
        && value.nickname.size() >= 2
        && value.nickname.size() <= 20
        && (value.avatarPath == null || value.avatarPath is string);
    }

    function validCategory(value) {
      return value in [
        "place",
        "restaurant",
        "ktv_song",
        "movie",
        "activity",
        "other"
      ];
    }

    function validIdeaStatus(value) {
      return value in ["idea", "scheduled", "completed"];
    }

    function validOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function validMedia(groupId, ideaId, value) {
      return value == null
        || (
          value is map
          && value.keys().hasAll([
            "storagePath",
            "mimeType",
            "width",
            "height",
            "byteSize"
          ])
          && value.keys().hasOnly([
            "storagePath",
            "mimeType",
            "width",
            "height",
            "byteSize"
          ])
          && value.storagePath is string
          && value.storagePath.matches(
            '^groups/' + groupId + '/ideas/' + ideaId
              + '/cover/[A-Za-z0-9_-]+[.]webp$'
          )
          && value.mimeType == "image/webp"
          && value.width is int
          && value.width > 0
          && value.width <= 4096
          && value.height is int
          && value.height > 0
          && value.height <= 4096
          && value.byteSize is int
          && value.byteSize > 0
          && value.byteSize <= 2 * 1024 * 1024
        );
    }

    function validCompletionPhoto(groupId, ideaId, value) {
      return value == null
        || (
          value is map
          && value.keys().hasAll([
            "storagePath",
            "mimeType",
            "width",
            "height",
            "byteSize"
          ])
          && value.keys().hasOnly([
            "storagePath",
            "mimeType",
            "width",
            "height",
            "byteSize"
          ])
          && value.storagePath is string
          && value.storagePath.matches(
            '^groups/' + groupId + '/ideas/' + ideaId
              + '/completion/[A-Za-z0-9_-]+[.]webp$'
          )
          && value.mimeType == "image/webp"
          && value.width is int
          && value.width > 0
          && value.width <= 4096
          && value.height is int
          && value.height > 0
          && value.height <= 4096
          && value.byteSize is int
          && value.byteSize > 0
          && value.byteSize <= 2 * 1024 * 1024
        );
    }

    function validTimezone(value) {
      return value is string
        && value.size() >= 3
        && value.size() <= 64
        && value.matches(
          '^(UTC|GMT|[A-Za-z_]+(/[A-Za-z0-9_+.-]+)+)$'
        );
    }

    function validSchedule(value) {
      return value is map
        && value.keys().hasAll([
          "startAt",
          "timezone",
          "meetingPoint",
          "note",
          "scheduledBy",
          "schedulerSnapshot",
          "scheduledAt",
          "updatedBy",
          "updatedAt",
          "revision"
        ])
        && value.keys().hasOnly([
          "startAt",
          "timezone",
          "meetingPoint",
          "note",
          "scheduledBy",
          "schedulerSnapshot",
          "scheduledAt",
          "updatedBy",
          "updatedAt",
          "revision"
        ])
        && value.startAt is timestamp
        && validTimezone(value.timezone)
        && validOptionalString(value.meetingPoint, 200)
        && validOptionalString(value.note, 500)
        && value.scheduledBy is string
        && validSnapshot(value.schedulerSnapshot)
        && value.scheduledAt is timestamp
        && value.updatedBy is string
        && value.updatedAt is timestamp
        && value.revision is int
        && value.revision >= 1;
    }

    function validCompletion(groupId, ideaId, value) {
      return value is map
        && value.keys().hasAll([
          "completedOn",
          "timezone",
          "photo",
          "review",
          "rating",
          "completedBy",
          "completerSnapshot",
          "completedAt",
          "updatedBy",
          "updatedAt"
        ])
        && value.keys().hasOnly([
          "completedOn",
          "timezone",
          "photo",
          "review",
          "rating",
          "completedBy",
          "completerSnapshot",
          "completedAt",
          "updatedBy",
          "updatedAt"
        ])
        && value.completedOn is string
        && value.completedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validTimezone(value.timezone)
        && validCompletionPhoto(groupId, ideaId, value.photo)
        && validOptionalString(value.review, 500)
        && (
          value.rating == null
          || (value.rating is int && value.rating >= 1 && value.rating <= 5)
        )
        && value.completedBy is string
        && validSnapshot(value.completerSnapshot)
        && value.completedAt is timestamp
        && value.updatedBy is string
        && value.updatedAt is timestamp;
    }

    function validReactionCounts(value) {
      return value is map
        && value.keys().hasAll(["want", "ok", "notInterested"])
        && value.keys().hasOnly(["want", "ok", "notInterested"])
        && value.want is int
        && value.want >= 0
        && value.ok is int
        && value.ok >= 0
        && value.notInterested is int
        && value.notInterested >= 0;
    }

    function validRsvpCounts(value) {
      return value is map
        && value.keys().hasAll(["going", "maybe", "notGoing"])
        && value.keys().hasOnly(["going", "maybe", "notGoing"])
        && value.going is int
        && value.going >= 0
        && value.maybe is int
        && value.maybe >= 0
        && value.notGoing is int
        && value.notGoing >= 0;
    }

    function validIdeaShape(groupId, ideaId, value) {
      return value.keys().hasAll([
          "groupId",
          "title",
          "category",
          "note",
          "media",
          "locationOrLink",
          "createdBy",
          "creatorSnapshot",
          "status",
          "schedule",
          "completion",
          "reactionCounts",
          "rsvpCounts",
          "commentCount",
          "reminderClaimedAt",
          "reminderSentAt",
          "reminderSkippedReason",
          "lastModifiedBy",
          "createdAt",
          "updatedAt",
          "isDeleted",
          "deletedAt",
          "deletedBy",
          "schemaVersion"
        ])
        && value.keys().hasOnly([
          "groupId",
          "title",
          "category",
          "note",
          "media",
          "locationOrLink",
          "createdBy",
          "creatorSnapshot",
          "status",
          "schedule",
          "completion",
          "reactionCounts",
          "rsvpCounts",
          "commentCount",
          "reminderClaimedAt",
          "reminderSentAt",
          "reminderSkippedReason",
          "lastModifiedBy",
          "createdAt",
          "updatedAt",
          "isDeleted",
          "deletedAt",
          "deletedBy",
          "schemaVersion"
        ])
        && value.groupId == groupId
        && value.title is string
        && value.title.size() >= 1
        && value.title.size() <= 80
        && validCategory(value.category)
        && validOptionalString(value.note, 1000)
        && validMedia(groupId, ideaId, value.media)
        && validOptionalString(value.locationOrLink, 500)
        && value.createdBy is string
        && validSnapshot(value.creatorSnapshot)
        && validIdeaStatus(value.status)
        && (
          (value.status == "idea"
            && value.schedule == null
            && value.completion == null)
          || (value.status == "scheduled"
            && validSchedule(value.schedule)
            && value.completion == null)
          || (value.status == "completed"
            && validSchedule(value.schedule)
            && validCompletion(groupId, ideaId, value.completion))
        )
        && validReactionCounts(value.reactionCounts)
        && validRsvpCounts(value.rsvpCounts)
        && value.commentCount is int
        && value.commentCount >= 0
        && (
          value.reminderClaimedAt == null
          || value.reminderClaimedAt is timestamp
        )
        && (
          value.reminderSentAt == null
          || value.reminderSentAt is timestamp
        )
        && (
          value.reminderSkippedReason == null
          || value.reminderSkippedReason is string
        )
        && value.lastModifiedBy is string
        && value.createdAt is timestamp
        && value.updatedAt is timestamp
        && value.isDeleted is bool
        && (value.deletedAt == null || value.deletedAt is timestamp)
        && (value.deletedBy == null || value.deletedBy is string)
        && value.schemaVersion == 1;
    }

    function validEditableIdeaFields(groupId, ideaId, value) {
      return value.title is string
        && value.title.size() >= 1
        && value.title.size() <= 80
        && validCategory(value.category)
        && validOptionalString(value.note, 1000)
        && validMedia(groupId, ideaId, value.media)
        && validOptionalString(value.locationOrLink, 500);
    }

    function parentIdeaAllowsInteraction(groupId, ideaId) {
      let idea = get(
        /databases/$(database)/documents/groups/$(groupId)/ideas/$(ideaId)
      ).data;
      return isActiveMember(groupId)
        && idea.isDeleted == false
        && idea.status in ["idea", "scheduled"];
    }

    function parentIdeaAllowsComment(groupId, ideaId) {
      let idea = get(
        /databases/$(database)/documents/groups/$(groupId)/ideas/$(ideaId)
      ).data;
      return isActiveMember(groupId) && idea.isDeleted == false;
    }

    function validReactionShape(groupId, ideaId, uid, value) {
      return value.keys().hasAll([
          "groupId",
          "ideaId",
          "userId",
          "value",
          "userSnapshot",
          "createdAt",
          "updatedAt",
          "schemaVersion"
        ])
        && value.keys().hasOnly([
          "groupId",
          "ideaId",
          "userId",
          "value",
          "userSnapshot",
          "createdAt",
          "updatedAt",
          "schemaVersion"
        ])
        && value.groupId == groupId
        && value.ideaId == ideaId
        && value.userId == uid
        && value.value in ["want", "ok", "not_interested"]
        && validSnapshot(value.userSnapshot)
        && value.createdAt is timestamp
        && value.updatedAt is timestamp
        && value.schemaVersion == 1;
    }

    function validCommentShape(value) {
      return value.keys().hasAll([
          "content",
          "createdBy",
          "creatorSnapshot",
          "createdAt",
          "isDeleted",
          "deletedAt",
          "deletedBy",
          "schemaVersion"
        ])
        && value.keys().hasOnly([
          "content",
          "createdBy",
          "creatorSnapshot",
          "createdAt",
          "isDeleted",
          "deletedAt",
          "deletedBy",
          "schemaVersion"
        ])
        && value.content is string
        && value.content.size() >= 1
        && value.content.size() <= 500
        && value.createdBy is string
        && validSnapshot(value.creatorSnapshot)
        && value.createdAt is timestamp
        && value.isDeleted is bool
        && (value.deletedAt == null || value.deletedAt is timestamp)
        && (value.deletedBy == null || value.deletedBy is string)
        && value.schemaVersion == 1;
    }

    function parentIdeaScheduleRevision(groupId, ideaId) {
      return get(
        /databases/$(database)/documents/groups/$(groupId)/ideas/$(ideaId)
      ).data.schedule.revision;
    }

    function parentIdeaAllowsRsvp(groupId, ideaId) {
      let idea = get(
        /databases/$(database)/documents/groups/$(groupId)/ideas/$(ideaId)
      ).data;
      return isActiveMember(groupId)
        && idea.isDeleted == false
        && idea.status == "scheduled"
        && validSchedule(idea.schedule);
    }

    function validRsvpShape(groupId, ideaId, uid, value) {
      return value.keys().hasAll([
          "groupId",
          "ideaId",
          "userId",
          "value",
          "scheduleRevision",
          "userSnapshot",
          "createdAt",
          "updatedAt",
          "schemaVersion"
        ])
        && value.keys().hasOnly([
          "groupId",
          "ideaId",
          "userId",
          "value",
          "scheduleRevision",
          "userSnapshot",
          "createdAt",
          "updatedAt",
          "schemaVersion"
        ])
        && value.groupId == groupId
        && value.ideaId == ideaId
        && value.userId == uid
        && value.value in ["going", "maybe", "not_going"]
        && value.scheduleRevision is int
        && value.scheduleRevision >= 1
        && validSnapshot(value.userSnapshot)
        && value.createdAt is timestamp
        && value.updatedAt is timestamp
        && value.schemaVersion == 1;
    }

    function validNickname(value) {
      return value is string && value.size() >= 2 && value.size() <= 20;
    }

    function validAvatarPath(uid, value) {
      return value == null
        || (
          value is string
          && value.matches(
            '^users/' + uid + '/avatar/[A-Za-z0-9_-]+[.]webp$'
          )
        );
    }

    function validNotificationPrefs(value) {
      return value is map
        && value.keys().hasAll([
          "groupInvite",
          "newSchedule",
          "upcomingReminder",
          "ideaComment"
        ])
        && value.keys().hasOnly([
          "groupInvite",
          "newSchedule",
          "upcomingReminder",
          "ideaComment"
        ])
        && value.groupInvite is bool
        && value.newSchedule is bool
        && value.upcomingReminder is bool
        && value.ideaComment is bool;
    }

    function defaultNotificationPrefs(value) {
      return value == {
        "groupInvite": true,
        "newSchedule": true,
        "upcomingReminder": true,
        "ideaComment": true
      };
    }

    function validDeviceShape(value) {
      return value is map
        && value.keys().hasAll([
          "token",
          "platform",
          "appVersion",
          "locale",
          "createdAt",
          "updatedAt"
        ])
        && value.keys().hasOnly([
          "token",
          "platform",
          "appVersion",
          "locale",
          "createdAt",
          "updatedAt"
        ])
        && value.token is string
        && value.token.size() >= 1
        && value.token.size() <= 4096
        && value.platform == "android"
        && value.appVersion is string
        && value.appVersion.size() >= 1
        && value.appVersion.size() <= 64
        && value.locale is string
        && value.locale.size() >= 2
        && value.locale.size() <= 35
        && value.createdAt is timestamp
        && value.updatedAt is timestamp;
    }

    function validFeedShape(value) {
      return value is map
        && value.keys().hasAll([
          "type",
          "groupId",
          "groupNameSnapshot",
          "ideaId",
          "ideaTitleSnapshot",
          "invitationId",
          "actorId",
          "actorSnapshot",
          "createdAt",
          "readAt",
          "expiresAt",
          "schemaVersion"
        ])
        && value.keys().hasOnly([
          "type",
          "groupId",
          "groupNameSnapshot",
          "ideaId",
          "ideaTitleSnapshot",
          "invitationId",
          "actorId",
          "actorSnapshot",
          "createdAt",
          "readAt",
          "expiresAt",
          "schemaVersion"
        ])
        && value.type in [
          "idea_created",
          "schedule_created",
          "schedule_updated",
          "idea_commented",
          "idea_completed",
          "group_invited"
        ]
        && value.groupId is string
        && value.groupId.size() >= 1
        && value.groupId.size() <= 128
        && value.groupNameSnapshot is string
        && value.groupNameSnapshot.size() >= 1
        && value.groupNameSnapshot.size() <= 30
        && (value.ideaId == null || value.ideaId is string)
        && (
          value.ideaTitleSnapshot == null
          || (
            value.ideaTitleSnapshot is string
            && value.ideaTitleSnapshot.size() <= 80
          )
        )
        && (value.invitationId == null || value.invitationId is string)
        && value.actorId is string
        && validSnapshot(value.actorSnapshot)
        && value.createdAt is timestamp
        && (value.readAt == null || value.readAt is timestamp)
        && value.expiresAt is timestamp
        && value.schemaVersion == 1;
    }

    function tokenEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function validUserShape(uid, value) {
      return value.keys().hasAll([
          "nickname",
          "avatarPath",
          "emailVerified",
          "notificationPrefs",
          "status",
          "createdAt",
          "updatedAt",
          "schemaVersion"
        ])
        && value.keys().hasOnly([
          "nickname",
          "avatarPath",
          "emailVerified",
          "notificationPrefs",
          "status",
          "createdAt",
          "updatedAt",
          "schemaVersion"
        ])
        && validNickname(value.nickname)
        && validAvatarPath(uid, value.avatarPath)
        && value.emailVerified is bool
        && validNotificationPrefs(value.notificationPrefs)
        && value.status == "active"
        && value.createdAt is timestamp
        && value.updatedAt is timestamp
        && value.schemaVersion == 1;
    }

    function validUserCreate(uid) {
      return isOwner(uid)
        && validUserShape(uid, request.resource.data)
        && defaultNotificationPrefs(request.resource.data.notificationPrefs)
        && request.resource.data.emailVerified == tokenEmailVerified()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if validUserCreate(uid);
      allow update: if isOwner(uid)
        && validUserShape(uid, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "nickname",
          "avatarPath",
          "notificationPrefs",
          "emailVerified",
          "updatedAt"
        ])
        && request.resource.data.updatedAt == request.time
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(["emailVerified"])
          || request.resource.data.emailVerified == tokenEmailVerified()
        );
      allow delete: if false;

      match /devices/{deviceId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && deviceId.size() >= 16
          && deviceId.size() <= 128
          && validDeviceShape(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(uid)
          && validDeviceShape(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "token",
            "platform",
            "appVersion",
            "locale",
            "updatedAt"
          ])
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);
      }

      match /feed/{feedId} {
        allow read: if isOwner(uid) && validFeedShape(resource.data);
        allow update: if isOwner(uid)
          && validFeedShape(request.resource.data)
          && resource.data.readAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"])
          && request.resource.data.readAt == request.time;
        allow create, delete: if false;
      }

      match /invitations/{invitationId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "respondedAt"
          ])
          && resource.data.status == "pending"
          && request.resource.data.status == "declined"
          && request.resource.data.respondedAt == request.time;
        allow create, delete: if false;
      }
    }

    match /groups/{groupId} {
      allow read: if isActiveMember(groupId);
      allow write: if false;

      match /members/{uid} {
        allow read: if isOwnMembership() || isActiveMember(groupId);
        allow write: if false;
      }

      match /ideas/{ideaId} {
        allow read: if isActiveMember(groupId) && resource.data.isDeleted == false;
        allow create: if isActiveMember(groupId)
          && validIdeaShape(groupId, ideaId, request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.creatorSnapshot == currentProfileSnapshot(groupId)
          && request.resource.data.status == "idea"
          && request.resource.data.schedule == null
          && request.resource.data.completion == null
          && request.resource.data.reactionCounts == {
            "want": 0,
            "ok": 0,
            "notInterested": 0
          }
          && request.resource.data.rsvpCounts == {
            "going": 0,
            "maybe": 0,
            "notGoing": 0
          }
          && request.resource.data.commentCount == 0
          && request.resource.data.reminderClaimedAt == null
          && request.resource.data.reminderSentAt == null
          && request.resource.data.reminderSkippedReason == null
          && request.resource.data.lastModifiedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.isDeleted == false
          && request.resource.data.deletedAt == null
          && request.resource.data.deletedBy == null;
        allow update: if isActiveMember(groupId)
          && (
            (
              resource.data.isDeleted == false
              && request.resource.data.isDeleted == false
              && resource.data.status == "scheduled"
              && request.resource.data.status == "completed"
              && request.resource.data.schedule == resource.data.schedule
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "status",
                "completion",
                "lastModifiedBy",
                "updatedAt"
              ])
              && validCompletion(groupId, ideaId, request.resource.data.completion)
              && request.resource.data.completion.completedBy == request.auth.uid
              && request.resource.data.completion.completerSnapshot
                == currentProfileSnapshot(groupId)
              && request.resource.data.completion.completedAt == request.time
              && request.resource.data.completion.updatedBy == request.auth.uid
              && request.resource.data.completion.updatedAt == request.time
              && request.resource.data.lastModifiedBy == request.auth.uid
              && request.resource.data.updatedAt == request.time
            )
            || (
              resource.data.isDeleted == false
              && request.resource.data.isDeleted == false
              && resource.data.status == "completed"
              && request.resource.data.status == "completed"
              && request.resource.data.schedule == resource.data.schedule
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "completion",
                "lastModifiedBy",
                "updatedAt"
              ])
              && validCompletion(groupId, ideaId, request.resource.data.completion)
              && request.resource.data.completion.completedBy
                == resource.data.completion.completedBy
              && request.resource.data.completion.completerSnapshot
                == resource.data.completion.completerSnapshot
              && request.resource.data.completion.completedAt
                == resource.data.completion.completedAt
              && request.resource.data.completion.updatedBy == request.auth.uid
              && request.resource.data.completion.updatedAt == request.time
              && request.resource.data.lastModifiedBy == request.auth.uid
              && request.resource.data.updatedAt == request.time
            )
            || (
              resource.data.isDeleted == false
              && request.resource.data.isDeleted == false
              && resource.data.status == "idea"
              && request.resource.data.status == "scheduled"
              && resource.data.schedule == null
              && request.resource.data.completion == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "status",
                "schedule",
                "lastModifiedBy",
                "updatedAt"
              ])
              && validSchedule(request.resource.data.schedule)
              && request.resource.data.schedule.revision == 1
              && request.resource.data.schedule.scheduledBy == request.auth.uid
              && request.resource.data.schedule.schedulerSnapshot
                == currentProfileSnapshot(groupId)
              && request.resource.data.schedule.scheduledAt == request.time
              && request.resource.data.schedule.updatedBy == request.auth.uid
              && request.resource.data.schedule.updatedAt == request.time
              && request.resource.data.lastModifiedBy == request.auth.uid
              && request.resource.data.updatedAt == request.time
            )
            || (
              resource.data.isDeleted == false
              && request.resource.data.isDeleted == false
              && resource.data.status == "scheduled"
              && request.resource.data.status == "scheduled"
              && request.resource.data.completion == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "schedule",
                "lastModifiedBy",
                "updatedAt"
              ])
              && validSchedule(request.resource.data.schedule)
              && request.resource.data.schedule.scheduledBy
                == resource.data.schedule.scheduledBy
              && request.resource.data.schedule.schedulerSnapshot
                == resource.data.schedule.schedulerSnapshot
              && request.resource.data.schedule.scheduledAt
                == resource.data.schedule.scheduledAt
              && request.resource.data.schedule.revision
                == resource.data.schedule.revision + 1
              && request.resource.data.schedule.updatedBy == request.auth.uid
              && request.resource.data.schedule.updatedAt == request.time
              && request.resource.data.lastModifiedBy == request.auth.uid
              && request.resource.data.updatedAt == request.time
            )
            || (
              resource.data.isDeleted == false
              && request.resource.data.isDeleted == false
              && resource.data.createdBy == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "title",
                "category",
                "note",
                "media",
                "locationOrLink",
                "lastModifiedBy",
                "updatedAt"
              ])
              && validEditableIdeaFields(groupId, ideaId, request.resource.data)
              && request.resource.data.lastModifiedBy == request.auth.uid
              && request.resource.data.updatedAt == request.time
            )
            || (
              resource.data.isDeleted == false
              && request.resource.data.isDeleted == true
              && (
                resource.data.createdBy == request.auth.uid
                || isAdmin(groupId)
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "isDeleted",
                "deletedAt",
                "deletedBy",
                "lastModifiedBy",
                "updatedAt"
              ])
              && request.resource.data.deletedAt == request.time
              && request.resource.data.deletedBy == request.auth.uid
              && request.resource.data.lastModifiedBy == request.auth.uid
              && request.resource.data.updatedAt == request.time
            )
          );
        allow delete: if false;

        match /reactions/{uid} {
          allow read: if isActiveMember(groupId)
            && get(
              /databases/$(database)/documents/groups/$(groupId)/ideas/$(ideaId)
            ).data.isDeleted == false;
          allow create: if signedIn()
            && request.auth.uid == uid
            && parentIdeaAllowsInteraction(groupId, ideaId)
            && validReactionShape(groupId, ideaId, uid, request.resource.data)
            && request.resource.data.userSnapshot == currentProfileSnapshot(groupId)
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;
          allow update: if signedIn()
            && request.auth.uid == uid
            && parentIdeaAllowsInteraction(groupId, ideaId)
            && validReactionShape(groupId, ideaId, uid, request.resource.data)
            && request.resource.data.userSnapshot == currentProfileSnapshot(groupId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "value",
              "userSnapshot",
              "updatedAt"
            ])
            && request.resource.data.updatedAt == request.time;
          allow delete: if signedIn()
            && request.auth.uid == uid
            && parentIdeaAllowsInteraction(groupId, ideaId);
        }

        match /comments/{commentId} {
          allow read: if isActiveMember(groupId)
            && get(
              /databases/$(database)/documents/groups/$(groupId)/ideas/$(ideaId)
            ).data.isDeleted == false
            && resource.data.isDeleted == false;
          allow create: if parentIdeaAllowsComment(groupId, ideaId)
            && validCommentShape(request.resource.data)
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.creatorSnapshot == currentProfileSnapshot(groupId)
            && request.resource.data.createdAt == request.time
            && request.resource.data.isDeleted == false
            && request.resource.data.deletedAt == null
            && request.resource.data.deletedBy == null;
          allow update: if isActiveMember(groupId)
            && validCommentShape(request.resource.data)
            && resource.data.isDeleted == false
            && request.resource.data.isDeleted == true
            && (
              resource.data.createdBy == request.auth.uid
              || isAdmin(groupId)
            )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "isDeleted",
              "deletedAt",
              "deletedBy"
            ])
            && request.resource.data.deletedAt == request.time
            && request.resource.data.deletedBy == request.auth.uid;
          allow delete: if false;
        }

        match /rsvps/{uid} {
          allow read: if isActiveMember(groupId)
            && get(
              /databases/$(database)/documents/groups/$(groupId)/ideas/$(ideaId)
            ).data.isDeleted == false;
          allow create: if signedIn()
            && request.auth.uid == uid
            && parentIdeaAllowsRsvp(groupId, ideaId)
            && validRsvpShape(groupId, ideaId, uid, request.resource.data)
            && request.resource.data.scheduleRevision
              == parentIdeaScheduleRevision(groupId, ideaId)
            && request.resource.data.userSnapshot == currentProfileSnapshot(groupId)
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;
          allow update: if signedIn()
            && request.auth.uid == uid
            && parentIdeaAllowsRsvp(groupId, ideaId)
            && validRsvpShape(groupId, ideaId, uid, request.resource.data)
            && request.resource.data.scheduleRevision
              == parentIdeaScheduleRevision(groupId, ideaId)
            && request.resource.data.userSnapshot == currentProfileSnapshot(groupId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "value",
              "scheduleRevision",
              "userSnapshot",
              "updatedAt"
            ])
            && request.resource.data.updatedAt == request.time;
          allow delete: if signedIn()
            && request.auth.uid == uid
            && parentIdeaAllowsRsvp(groupId, ideaId);
        }
      }
    }

    match /groupInvites/{inviteId} {
      allow read, write: if false;
    }

    match /functionEvents/{eventId} {
      allow read, write: if false;
    }

    match /{path=**}/members/{uid} {
      allow read: if isOwnMembership();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
