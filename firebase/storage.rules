rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function validImage() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function validAvatar(fileName) {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == "image/webp"
        && fileName.matches('^[A-Za-z0-9_-]+[.]webp$');
    }

    function isActiveMember(groupId) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/groups/$(groupId)
        )
        && firestore.get(
          /databases/(default)/documents/groups/$(groupId)
        ).data.status == "active"
        && firestore.exists(
          /databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)
        ).data.status == "active";
    }

    match /users/{uid}/avatar/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && validAvatar(fileName);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{groupId}/ideas/{ideaId}/{allPaths=**} {
      allow read: if isActiveMember(groupId);
      allow create, update: if isActiveMember(groupId) && validImage();
      allow delete: if isActiveMember(groupId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
